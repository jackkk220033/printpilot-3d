rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Atelier privé : un utilisateur n'accède qu'à son propre document.
    match /workspaces/{ownerUid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == ownerUid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
