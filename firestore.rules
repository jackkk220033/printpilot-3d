rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{ownerUid} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
      // Petites photos JPEG compressees, separees du document d’inventaire.
      match /photos/{photoId} {
        allow read: if request.auth != null && request.auth.uid == ownerUid;
        allow create, update: if request.auth != null
          && request.auth.uid == ownerUid
          && request.resource.data.keys().hasOnly(['key','image','updatedAt'])
          && request.resource.data.key is string
          && request.resource.data.key.size() <= 300
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 285000
          && request.resource.data.image.matches('^data:image/jpeg;base64,.*$');
        allow delete: if false;
      }
    }
    // Portail Boutique v4.7 : seuls les comptes explicitement autorisés lisent la copie publique filtrée.
    // Les /workspaces et les photos privées ne deviennent JAMAIS lisibles par les boutiques.
    function isBoutiqueOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }
    function canViewBoutique(ownerUid) {
      return request.auth != null && (
        request.auth.uid == ownerUid ||
        exists(/databases/$(database)/documents/boutiques/$(ownerUid)/members/$(request.auth.uid))
      );
    }
    match /boutiques/{ownerUid} {
      allow read, write: if false;
      match /members/{memberUid} {
        allow get: if isBoutiqueOwner(ownerUid) ||
          (request.auth != null && request.auth.uid == memberUid);
        allow list: if false;
        allow create, update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['role','addedAt'])
          && request.resource.data.role == 'viewer';
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      match /catalogue/{docId} {
        allow get: if docId == 'current' && canViewBoutique(ownerUid);
        allow list: if false;
        allow create, update: if docId == 'current' && isBoutiqueOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['version','products','publishedAt'])
          && request.resource.data.version == 1
          && request.resource.data.products is list
          && request.resource.data.products.size() <= 450;
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      // v4.8 — boutique peut ENVOYER, seul le propriétaire peut LIRE et classer.
      match /messages/{messageId} {
        allow create: if canViewBoutique(ownerUid)
          && request.resource.data.keys().hasOnly(['senderUid','senderEmail','body','productId','productName','createdAt','read'])
          && request.resource.data.keys().hasAll(['senderUid','senderEmail','body','productId','productName','createdAt','read'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail is string
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.senderEmail.size() <= 254
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && request.resource.data.body.size() <= 1200
          && request.resource.data.productId is string
          && request.resource.data.productId.size() <= 160
          && request.resource.data.productName is string
          && request.resource.data.productName.size() <= 160
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false;
        allow get, list: if isBoutiqueOwner(ownerUid);
        allow update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      // v4.9 — Demandes boutique: seules des demandes en attente peuvent être créées.
      match /requests/{requestId} {
        allow create: if canViewBoutique(ownerUid)
          && request.resource.data.keys().hasOnly(['kind','productId','productName','shopId','quantity','unitPrice','note','senderUid','senderEmail','status','createdAt'])
          && request.resource.data.keys().hasAll(['kind','productId','productName','shopId','quantity','unitPrice','note','senderUid','senderEmail','status','createdAt'])
          && request.resource.data.kind in ['sale','restock']
          && request.resource.data.productId is string && request.resource.data.productId.size() <= 160
          && request.resource.data.productName is string && request.resource.data.productName.size() <= 160
          && request.resource.data.shopId is string && request.resource.data.shopId.size() <= 32
          && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 300
          && request.resource.data.unitPrice is number && request.resource.data.unitPrice >= 0 && request.resource.data.unitPrice <= 10000
          && request.resource.data.note is string && request.resource.data.note.size() <= 400
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow get, list: if isBoutiqueOwner(ownerUid);
        allow update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt'])
          && request.resource.data.status in ['pending','accepted','rejected']
          && request.resource.data.resolvedAt == request.time;
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      // v4.9 — Données Atelier + privées, indépendantes du catalogue boutique.
      match /management/{docId} {
        allow read, write: if isBoutiqueOwner(ownerUid);
      }
      // JJ3D v4.11.30 — demandes d'impression spéciales Boutique : destinées à l'admin uniquement.
      match /customRequests/{requestId} {
        allow create: if canViewBoutique(ownerUid)
          && request.resource.data.keys().hasOnly(['customer','phone','email','item','quantity','colors','dueAt','note','photo','senderUid','senderEmail','status','createdAt'])
          && request.resource.data.keys().hasAll(['customer','phone','email','item','quantity','colors','dueAt','note','photo','senderUid','senderEmail','status','createdAt'])
          && request.resource.data.customer is string && request.resource.data.customer.size() >= 1 && request.resource.data.customer.size() <= 120
          && request.resource.data.phone is string && request.resource.data.phone.size() >= 5 && request.resource.data.phone.size() <= 30
          && request.resource.data.email is string && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$') && request.resource.data.email.size() <= 254
          && request.resource.data.item is string && request.resource.data.item.size() >= 1 && request.resource.data.item.size() <= 160
          && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 300
          && request.resource.data.colors is string && request.resource.data.colors.size() <= 160
          && request.resource.data.dueAt is string && request.resource.data.dueAt.size() <= 10
          && request.resource.data.note is string && request.resource.data.note.size() <= 1000
          && request.resource.data.photo is string && request.resource.data.photo.size() <= 150000
          && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/jpeg;base64,.*$'))
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow get, list: if isBoutiqueOwner(ownerUid) || (canViewBoutique(ownerUid) && resource.data.senderUid == request.auth.uid);
        allow update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt','quoteTotal','quoteInvoiceNumber','quotePreviewUrl'])
          && request.resource.data.status in ['accepted','rejected','reviewed','awaiting_payment','paid']
          && (!('quoteTotal' in request.resource.data) || (request.resource.data.quoteTotal is number && request.resource.data.quoteTotal >= 0 && request.resource.data.quoteTotal <= 100000))
          && (!('quoteInvoiceNumber' in request.resource.data) || (request.resource.data.quoteInvoiceNumber is string && request.resource.data.quoteInvoiceNumber.size() <= 60))
          && (!('quotePreviewUrl' in request.resource.data) || (request.resource.data.quotePreviewUrl is string && request.resource.data.quotePreviewUrl.size() <= 600))
          && request.resource.data.resolvedAt == request.time;
        // Un membre autorisé peut uniquement déclarer le paiement de sa propre demande,
        // sans pouvoir valider celui-ci ni changer le prix ou le client.
        allow update: if canViewBoutique(ownerUid) && resource.data.senderUid == request.auth.uid
          && resource.data.status == 'awaiting_payment'
          && request.resource.data.status == 'payment_reported'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paymentAmount','paymentMethod','paymentDate','paymentReportedAt'])
          && request.resource.data.paymentAmount is number && request.resource.data.paymentAmount > 0 && request.resource.data.paymentAmount <= 100000
          && request.resource.data.paymentMethod is string && request.resource.data.paymentMethod in ['Espèces','Virement Interac','Carte','Autre']
          && request.resource.data.paymentDate is string && request.resource.data.paymentDate.size() == 10
          && request.resource.data.paymentReportedAt == request.time;
        // v4.11.43: both portals may delete an unpaid request; paid history is protected.
        allow delete: if isBoutiqueOwner(ownerUid) ||
          (canViewBoutique(ownerUid) && resource.data.senderUid == request.auth.uid && resource.data.status != 'paid');
      }
      // v4.11 — Commandes en une seule étape : boutique écrit, administrateur traite.
      match /orders/{orderId} {
        allow create: if canViewBoutique(ownerUid)
          && request.resource.data.keys().hasOnly(['items','note','senderUid','senderEmail','status','createdAt'])
          && request.resource.data.keys().hasAll(['items','note','senderUid','senderEmail','status','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.senderEmail is string
          && request.resource.data.senderEmail.size() <= 254
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 400
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 25
          && request.resource.data.items[0] is map
          && request.resource.data.items[0].productId is string
          && request.resource.data.items[0].productId.size() <= 160;
        allow get, list: if isBoutiqueOwner(ownerUid);
        allow update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt'])
          && request.resource.data.status in ['accepted','rejected']
          && request.resource.data.resolvedAt == request.time;
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      // JJ3D v4.11.19 — Bons d'envoi filtrés; l'inventaire privé n'est pas exposé.
      match /deliveries/{docId} {
        allow get: if docId == 'current' && canViewBoutique(ownerUid);
        allow list: if false;
        allow create, update: if docId == 'current' && isBoutiqueOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['items','updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 120;
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      match /deliveryReceipts/{slipId} {
        allow create: if canViewBoutique(ownerUid)
          && request.auth.uid != ownerUid
          && request.resource.data.keys().hasOnly(['slipId','number','quantities','note','senderUid','senderEmail','status','createdAt'])
          && request.resource.data.slipId == slipId
          && request.resource.data.slipId is string && request.resource.data.slipId.size() <= 120
          && request.resource.data.number is string && request.resource.data.number.size() <= 80
          && request.resource.data.quantities is map && request.resource.data.quantities.keys().size() <= 80
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow get: if isBoutiqueOwner(ownerUid) || (canViewBoutique(ownerUid) && resource.data.senderUid == request.auth.uid);
        allow list: if isBoutiqueOwner(ownerUid);
        allow update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt'])
          && request.resource.data.status == 'processed'
          && request.resource.data.resolvedAt == request.time;
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      // Liste filtrée des prochaines impressions; pas d'accès au suivi privé.
      match /planning/{docId} {
        allow get: if docId == 'current' && canViewBoutique(ownerUid);
        allow list: if false;
        allow create, update: if docId == 'current' && isBoutiqueOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['items','updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 80;
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      match /planningPhotos/{photoId} {
        allow get: if canViewBoutique(ownerUid);
        allow list: if false;
        allow create, update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['image','updatedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 180000
          && request.resource.data.image.matches('^data:image/jpeg;base64,.*$');
        allow delete: if isBoutiqueOwner(ownerUid);
      }
      match /photos/{photoId} {
        allow get: if canViewBoutique(ownerUid);
        allow list: if false;
        allow create, update: if isBoutiqueOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['image','updatedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 285000
          && request.resource.data.image.matches('^data:image/jpeg;base64,.*$');
        allow delete: if isBoutiqueOwner(ownerUid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
